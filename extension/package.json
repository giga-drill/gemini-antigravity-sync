{
  "name": "gemini-chat-exporter",
  "version": "1.0.0",
  "description": "Export Gemini AI chat conversations to Markdown/PDF, save locally or to Google Drive",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:bundle": "tsc && vite build",
    "build:firefox": "cross-env BROWSER_TARGET=firefox vite build",
    "build:chrome": "cross-env BROWSER_TARGET=chrome vite build",
    "build:production": "sh ./scripts/build-production.sh",
    "build:debug": "sh ./scripts/build-debug.sh",
    "preview": "vite preview",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts,.tsx",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "html2pdf.js": "^0.14.0",
    "i18next": "^24.2.2",
    "idb": "^8.0.1",
    "jspdf": "^2.5.2",
    "marked": "^15.0.12",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.4.1",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.28",
    "@tailwindcss/vite": "^4.1.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^29.5.12",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/webextension-polyfill": "^0.12.1",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^22.1.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.3",
    "ts-jest": "^29.4.6",
    "typescript": "^5.7.0",
    "vite": "^6.2.0"
  }
}
